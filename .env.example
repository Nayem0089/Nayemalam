# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# WARZONE OFFICIAL — ESPORTS TOURNAMENT STANDINGS MANAGER
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=production

# Render PostgreSQL Database Connection
# In Render.com, this is automatically injected when linked with the managed database:
DATABASE_URL=postgresql://warzone_admin:password@localhost:5432/warzone_tournament?schema=public

# Security & Authentication
JWT_SECRET=replace_this_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_PASSWORD=admin123

# Optional: S3-Compatible Object Storage (Cloudflare R2, AWS S3, Backblaze B2, Supabase)
# If left blank, team logos and tournament emblems fallback to secure PostgreSQL database storage!
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=warzone-assets
S3_ACCESS_KEY=your_access_key_id
S3_SECRET_KEY=your_secret_access_key
S3_REGION=auto
S3_PUBLIC_URL=https://pub-your-id.r2.dev
